{
    "name": "vatly/vatly-pmpro",
    "description": "Paid Memberships Pro payment gateway for Vatly, the European Merchant of Record for AI, software and digital products. Stop maintaining your own VAT logic.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://vatly.com",
    "keywords": [
        "wordpress",
        "wordpress-plugin",
        "paid-memberships-pro",
        "pmpro",
        "vatly",
        "vat",
        "eu-vat",
        "merchant-of-record",
        "payment-gateway",
        "ai"
    ],
    "authors": [
        {
            "name": "Sander van Hooft",
            "email": "sander@sandorian.com",
            "homepage": "https://vatly.com"
        }
    ],
    "support": {
        "issues": "https://github.com/vatly/vatly-pmpro/issues",
        "source": "https://github.com/vatly/vatly-pmpro"
    },
    "require": {
        "php": ">=8.1",
        "vatly/vatly-fluent-php": "^0.8.0-alpha.34"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "yoast/phpunit-polyfills": "^2.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Vatly\\PMPro\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vatly\\PMPro\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit -c phpunit-integration.xml.dist",
        "analyse": "phpstan analyse --memory-limit=1G",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.1"
        },
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.3.x-dev"
        },
        "installer-name": "vatly-gateway-for-paid-memberships-pro"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
